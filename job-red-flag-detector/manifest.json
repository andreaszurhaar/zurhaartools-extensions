{
  "manifest_version": 3,
  "name": "Job Red Flag Detector",
  "description": "Instantly spot warning signs in job postings — vague salary, unrealistic requirements, toxic culture signals.",
  "version": "1.1.1",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "side_panel": {
    "default_path": "src/sidepanel.html"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.linkedin.com/*",
        "*://*.indeed.com/*",
        "*://*.glassdoor.com/*",
        "*://*.glassdoor.nl/*",
        "*://*.nationalevacaturebank.nl/*",
        "*://*.monster.com/*",
        "*://*.monster.nl/*",
        "*://*.reed.co.uk/*",
        "*://*.seek.com.au/*",
        "*://*.stepstone.de/*",
        "*://*.stepstone.nl/*"
      ],
      "js": ["src/content.js"],
      "css": ["src/content.css"]
    }
  ]
}
